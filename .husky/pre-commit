export NVM_DIR="$HOME/.nvm"
. "$NVM_DIR/nvm.sh"
nvm use

# pnpm 경로 추가
export PATH="$HOME/Library/pnpm:$PATH"

# Type-checked ESLint은 메모리 사용량이 큼 — 힙 상한을 4GB로 올리고
# 프로젝트별 ESLint가 동시에 떠서 OOM 나지 않도록 순차 실행
export NODE_OPTIONS="--max-old-space-size=4096"

# 변경 파일만 ESLint 검사
pnpm lint-staged --concurrent 1 || exit 1
