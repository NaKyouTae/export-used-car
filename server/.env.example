# Server
PORT=18090

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# JWT
JWT_SECRET="your-jwt-secret-change-this"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Supabase S3 Storage
SUPABASE_S3_ENDPOINT="https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3"
SUPABASE_S3_BUCKET="exports"
SUPABASE_ACCESS_KEY="your-supabase-access-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"
SUPABASE_PUBLIC_URL="https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public"

# Email (Nodemailer SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="ajucar0510@naver.com"

# Admin
ADMIN_TOKEN="admin-secret-change-me"
