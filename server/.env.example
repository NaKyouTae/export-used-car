# Server
PORT=18090

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# JWT
JWT_SECRET="your-jwt-secret-change-this"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Supabase S3 Storage
SUPABASE_S3_ENDPOINT="https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3"
SUPABASE_S3_BUCKET="exports"
SUPABASE_ACCESS_KEY="your-supabase-access-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"
SUPABASE_PUBLIC_URL="https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public"

# Email (Nodemailer SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="ajucar0510@naver.com"

# Admin
ADMIN_TOKEN="admin-secret-change-me"

# Google Cloud Translation (채팅 메시지 번역)
GOOGLE_TRANSLATE_API_KEY="your-google-cloud-translation-api-key"

# Firebase Admin (앱 푸시 / FCM) — 미설정 시 푸시는 건너뛰고 인앱 알림만 기록됨
# Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성(.json)에서 추출
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
# private_key는 줄바꿈을 \n 으로 이스케이프한 한 줄 문자열로 넣는다
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Google Play 검토용 테스트 계정 (미설정 시 우회 비활성)
REVIEW_TEST_EMAIL="google-review@ajucar.com"
REVIEW_TEST_CODE="000000"
